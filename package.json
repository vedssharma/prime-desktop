{
  "name": "session-dock",
  "version": "0.1.0",
  "description": "Session Dock \u2014 an unofficial desktop companion for Prime Agent CLI",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run notices && tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.tests.json",
    "package": "npm run check && npm run build && electron-builder --dir",
    "dist": "npm run check && npm run build && electron-builder",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test:ui": "playwright test",
    "notices": "npm run electron:install && node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check",
    "package:check": "node scripts/check-package.mjs",
    "test:notices": "node --test tests/notices.test.mjs",
    "test:electron": "npm run build && node scripts/test-electron.mjs",
    "check": "npm run typecheck && npm test && npm run test:notices && npm run test:ui",
    "electron:install": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.4",
    "electron-builder": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "io.github.vedssharma.sessiondock",
    "productName": "Session Dock",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "icon": "build/icon.png",
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      }
    ],
    "afterPack": "./scripts/check-package.mjs"
  },
  "license": "MIT",
  "author": "Ved Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedssharma/prime-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/vedssharma/prime-desktop/issues"
  },
  "homepage": "https://github.com/vedssharma/prime-desktop#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8"
}
